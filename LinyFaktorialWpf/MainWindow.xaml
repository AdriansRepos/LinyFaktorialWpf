<Window x:Class="LinyFaktorialWpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Líný Faktoriál 2.0 (Ultra Fňuk WPF)" Height="500" Width="480"
        WindowStartupLocation="CenterScreen" Background="#2D2D30">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <!-- Horní pevná část pro formulář a výsledky -->
            <RowDefinition Height="Auto"/>
            <!-- Dolní část jako hřiště pro utíkající tlačítko -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 1. FORMULÁŘ A VÝSTUPY -->
        <StackPanel Grid.Row="0" Margin="0,0,0,15">
            <TextBlock Text="Líný Počítač Faktoriálů" 
                       FontSize="22" FontWeight="Bold" Foreground="White" 
                       HorizontalAlignment="Center" Margin="0,0,0,15"/>

            <TextBlock Text="Zadej číslo:" Foreground="LightGray" Margin="0,0,0,5"/>
            <TextBox x:Name="txtVstup" FontSize="16" Padding="5" Margin="0,0,0,15"/>

            <!-- Posuvník přemýšlení -->
            <ProgressBar x:Name="progressPremysleni" Height="15" Margin="0,0,0,15" Visibility="Hidden"/>

            <!-- Výstupní text -->
            <TextBlock x:Name="lblVystup" FontSize="14" TextWrapping="Wrap" 
                       Foreground="Yellow" FontWeight="SemiBold" HorizontalAlignment="Center"/>
        </StackPanel>

        <!-- 2. HŘIŠTĚ PRO TLAČÍTKO -->
        <Canvas x:Name="hlavniPlatno" Grid.Row="1" Background="#222225" ClipToBounds="True">
            <Button x:Name="btnSpocitej" 
                    Content="Spočítej (chytni mě!)" 
                    Width="180" Height="40"
                    FontSize="14" FontWeight="Bold"
                    Background="#007ACC" Foreground="White"
                    Canvas.Left="130" Canvas.Top="80"
                    MouseEnter="BtnSpocitej_MouseEnter"
                    Click="BtnSpocitej_Click"/>
        </Canvas>
    </Grid>
</Window>